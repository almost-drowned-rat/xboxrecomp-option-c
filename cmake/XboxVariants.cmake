# XboxVariants.cmake - several versions of one title in one exe (src/kernel/xbox_variant.h; maintainer rule
# 2026-11-01, every port). A player's build has one version, ours several; the same call works for 1..N.
#
#   include(${XBOXRECOMP_DIR}/cmake/XboxVariants.cmake)
#   xbox_add_variants(TARGET <exe> GEN_ROOT <dir with one gen dir per version> MANUAL <manual .c>
#                     IDS <id> [<id> ...] [DEFINE_PREFIX <P>] [GEN_COMPILE_OPTIONS <opt> ...]
#                     [MANUAL_COMPILE_OPTIONS <opt> ...] [LINK <libs> ...] [INCLUDES <dirs> ...])
#
# For every id whose <GEN_ROOT>/<id>/recomp_prefix.h exists (tools/variant_prefix.py, run after the lift): one
# OBJECT library <exe>_v_<id> with that version's generated C and the manual file, all compiled with
# `-include <GEN_ROOT>/<id>/recomp_prefix.h`, the version's gen dir first on the include path, and the defines
# XBOX_VARIANT_ID="<id>" and <P><ID>=1 (P default XBOX_VARIANT_; e.g. B3_VARIANT_PAL_A=1). LINK / INCLUDES give
# the object libraries the exe's usage requirements (the toolkit libraries, the port's include dirs). Ids without
# a lift are skipped (a player's build lifts only his version).
#
# Writes <binary dir>/xbox_variants_list.h: `#define XBOX_VARIANT_LIST(X) X(us) X(pal_a) ...` for the versions
# built, so the port's main.c declares and registers exactly those. Sets XBOX_VARIANTS_BUILT (the ids) in the
# caller's scope. Fails when none of the ids has a lift.

function(xbox_add_variants)
    cmake_parse_arguments(XV "" "TARGET;GEN_ROOT;MANUAL;DEFINE_PREFIX"
                          "IDS;GEN_COMPILE_OPTIONS;MANUAL_COMPILE_OPTIONS;LINK;INCLUDES" ${ARGN})
    if(NOT XV_TARGET OR NOT XV_GEN_ROOT OR NOT XV_MANUAL OR NOT XV_IDS)
        message(FATAL_ERROR "xbox_add_variants: TARGET, GEN_ROOT, MANUAL and IDS are required")
    endif()
    if(NOT XV_DEFINE_PREFIX)
        set(XV_DEFINE_PREFIX XBOX_VARIANT_)
    endif()
    set(built "")
    set(list_x "")
    foreach(id IN LISTS XV_IDS)
        set(gen "${XV_GEN_ROOT}/${id}")
        if(NOT EXISTS "${gen}/recomp_prefix.h")
            message(STATUS "xbox_add_variants: ${id} skipped (no ${gen}/recomp_prefix.h)")
            continue()
        endif()
        file(GLOB gen_src CONFIGURE_DEPENDS "${gen}/recomp_*.c")
        set(obj ${XV_TARGET}_v_${id})
        add_library(${obj} OBJECT ${gen_src} ${XV_MANUAL})
        string(TOUPPER "${id}" ID)
        target_compile_definitions(${obj} PRIVATE XBOX_VARIANT_ID="${id}" ${XV_DEFINE_PREFIX}${ID}=1)
        target_compile_options(${obj} PRIVATE "SHELL:-include \"${gen}/recomp_prefix.h\"")
        target_include_directories(${obj} BEFORE PRIVATE "${gen}")
        if(XV_INCLUDES)
            target_include_directories(${obj} PRIVATE ${XV_INCLUDES})
        endif()
        if(XV_LINK)
            target_link_libraries(${obj} PRIVATE ${XV_LINK})
        endif()
        if(XV_GEN_COMPILE_OPTIONS)
            set_source_files_properties(${gen_src} TARGET_DIRECTORY ${obj} PROPERTIES
                                        COMPILE_OPTIONS "${XV_GEN_COMPILE_OPTIONS}")
        endif()
        if(XV_MANUAL_COMPILE_OPTIONS)
            set_source_files_properties(${XV_MANUAL} TARGET_DIRECTORY ${obj} PROPERTIES
                                        COMPILE_OPTIONS "${XV_MANUAL_COMPILE_OPTIONS}")
        endif()
        target_sources(${XV_TARGET} PRIVATE $<TARGET_OBJECTS:${obj}>)
        list(APPEND built ${id})
        string(APPEND list_x " X(${id})")
    endforeach()
    if(NOT built)
        message(FATAL_ERROR "xbox_add_variants: no lift for any of ${XV_IDS} under ${XV_GEN_ROOT} "
                            "(run the lift and tools/variant_prefix.py first)")
    endif()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/xbox_variants_list.h.tmp"
         "/* generated by cmake/XboxVariants.cmake: the versions linked into this exe */\n"
         "#define XBOX_VARIANT_LIST(X)${list_x}\n")
    configure_file("${CMAKE_CURRENT_BINARY_DIR}/xbox_variants_list.h.tmp"
                   "${CMAKE_CURRENT_BINARY_DIR}/xbox_variants_list.h" COPYONLY)   # rewritten only on a change
    target_include_directories(${XV_TARGET} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    message(STATUS "xbox_add_variants: ${XV_TARGET} gets ${built}")
    set(XBOX_VARIANTS_BUILT ${built} PARENT_SCOPE)
endfunction()
